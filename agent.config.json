{
  "autonomyLevel": 1,
  "autoMergeSizes": { "1": [], "2": ["S"], "3": ["S", "M"] },
  "wipLimit": 1,
  "maxTicketsStartedPerDay": 6,
  "maxAttemptsPerTicket": 2,
  "maxAgentProposedTicketsPerDay": 3,
  "maxTurns": { "refiner": 20, "worker": 80, "reviewer": 30, "digest": 30 },
  "workerCron": "0 */2 * * *",
  "architectureReviewEveryNMerges": 10,
  "models": { "refiner": "sonnet", "worker": "opus", "reviewer": "opus", "digest": "sonnet" },
  "workflowTimeoutMinutes": { "refiner": 15, "worker": 60, "reviewer": 20, "digest": 20 },
  "trustedSubmitters": [],
  "protectedPaths": [
    ".github/**",
    ".claude/**",
    ".agent/prompts/**",
    ".agent/LESSONS.md",
    ".gitignore",
    "CLAUDE.md",
    "PLAN.md",
    "agent.config.json",
    "scripts/agent/**",
    "scripts/setup/**",
    "scripts/check-test-integrity.ts",
    "package.json",
    "package-lock.json",
    ".nvmrc",
    "tsconfig*.json",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    ".dependency-cruiser.cjs",
    ".prettierrc.json",
    ".prettierignore",
    "e2e/fixtures.ts",
    "docs/DEFINITION_OF_READY.md",
    "docs/DEFINITION_OF_DONE.md",
    "docs/decisions/**"
  ],
  "goldenPaths": ["tests/replays/**"]
}
